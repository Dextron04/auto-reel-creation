OLLAMA_CF_ACCESS_CLIENT_ID=replace-with-cloudflare-access-client-id
OLLAMA_CF_ACCESS_CLIENT_SECRET=replace-with-cloudflare-access-client-secret
INSTAGRAM_ACCESS_TOKEN=replace-with-instagram-long-lived-access-token
